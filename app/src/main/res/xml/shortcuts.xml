<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon → "Summarize copied text": the fastest daily path. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="summarize_clipboard"
        android:enabled="true"
        android:icon="@mipmap/ic_shortcut_summarize"
        android:shortcutShortLabel="@string/shortcut_clipboard_short"
        android:shortcutLongLabel="@string/shortcut_clipboard_long">
        <intent
            android:action="com.nanodigest.action.SUMMARIZE_CLIPBOARD"
            android:targetPackage="com.nanodigest"
            android:targetClass="com.nanodigest.MainActivity" />
    </shortcut>
</shortcuts>
